# ── Large ML/data folders not needed on server ───────────────────────────────
datasets/
notebooks/
logs/
mlops/
mlruns/
experiments/
scripts/demo_assets/
scripts/*.jpg
scripts/*.png
scripts/*.webm

# ── Frontend (deployed to Vercel separately) ──────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.*

# ── Dev tooling ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Git ───────────────────────────────────────────────────────────────────────
.git/

# ── Env files (use Render dashboard for secrets) ─────────────────────────────
.env
.env.*
backend/.env
backend/firebase-service-account.json

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Virtual envs ─────────────────────────────────────────────────────────────
venv/
env/
.venv/
backend/venv/

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── User uploads (regenerated at runtime) ────────────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep
